# ============================================================================
# .dev.vars.example - Biến bí mật dùng khi chạy thử nghiệm `npx wrangler dev`
# Khi deploy lên Cloudflare Production, sử dụng `npx wrangler secret put <KEY>`
# TUYỆT ĐỐI KHÔNG COMMIT FILE .dev.vars CHỨA SECRET THẬT LÊN GIT!
# ============================================================================

META_APP_SECRET=your_meta_app_secret_here
SECRET_KEY=replace_with_32_byte_random_hmac_session_secret
ENCRYPTION_KEY=replace_with_32_byte_random_aes_256_gcm_key

