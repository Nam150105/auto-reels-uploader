# =========================================================================
# META DEVELOPER APP CONFIGURATION (FACEBOOK GRAPH API & REELS SCHEDULER)
# =========================================================================
# Lấy các thông số tại: https://developers.facebook.com/apps/

# 1. Meta App ID (ID ứng dụng: 1469615908436980)
META_APP_ID=1469615908436980

# 2. Meta App Secret (Khóa bí mật ứng dụng - CHỈ DÙNG Ở BACKEND)
META_APP_SECRET=

# 3. Base URL hệ thống (Tên miền chính thức qua Cloudflare Tunnel)
APP_BASE_URL=https://namnangno.click

# 4. OAuth Redirect URI (Phải trùng khớp với cấu hình trong Facebook Login Settings)
META_REDIRECT_URI=https://namnangno.click/api/meta/callback

# 5. Meta Graph API Version (v19.0)
META_GRAPH_VERSION=v19.0

# 6. Session Secret Key (Mã hóa phiên đăng nhập thành viên)
SECRET_KEY=
