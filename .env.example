# 1. Public Variables (Cấu hình trong wrangler.jsonc -> "vars")
META_APP_ID=1469615908436980
APP_BASE_URL=https://pagefb.namnangno.click
META_REDIRECT_URI=https://pagefb.namnangno.click/api/meta/callback
META_GRAPH_VERSION=v19.0
MAX_VIDEO_SIZE_MB=200

# 2. Cloudflare Secrets (Thiết lập qua `npx wrangler secret put <NAME>`)
# TUYỆT ĐỐI KHÔNG đặt giá trị thật vào repository hoặc wrangler.jsonc
META_APP_SECRET=your_meta_app_secret_here
SESSION_SECRET=replace_with_random_session_secret_key
TOKEN_ENCRYPTION_KEY=replace_with_random_aes_256_gcm_encryption_key
