{
  "name": "auto-reels-uploader",
  "version": "3.0.0",
  "private": true,
  "description": "Hệ thống Quản lý Facebook Fanpage & Hẹn lịch đăng Reels trên Cloudflare Workers Free (D1 + R2 + Queues + Cron + Meta Graph API)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ci_prepare_cloudflare.mjs",
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev",
    "build:ui": "vite build",
    "build:worker": "node scripts/ci_prepare_cloudflare.mjs",
    "build": "vite build && node scripts/ci_prepare_cloudflare.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.json --noEmit",
    "typecheck:ui": "vue-tsc -p tsconfig.app.json --noEmit",
    "test": "node tests/test_worker.mjs",
    "d1:create": "wrangler d1 create auto-reels-db",
    "d1:migrate:local": "wrangler d1 migrations apply auto-reels-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply auto-reels-db --remote",
    "d1:seed:local": "node scripts/migrate_manager_db_to_d1.mjs",
    "r2:create": "wrangler r2 bucket create auto-reels-media",
    "queue:create": "wrangler queues create reels-publish-queue",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.6.3",
    "vite": "^5.2.11",
    "vue-tsc": "^2.0.19",
    "wrangler": "^4.14.0"
  }
}
