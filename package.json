{
  "name": "auto-reels-uploader",
  "version": "3.0.0",
  "private": true,
  "description": "Hệ thống Quản lý Facebook Fanpage & Hẹn lịch đăng Reels trên Cloudflare Workers Free (D1 + R2 + Queues + Cron + Meta Graph API)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ci_prepare_cloudflare.mjs",
    "dev": "wrangler dev",
    "build": "node scripts/ci_prepare_cloudflare.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tests/test_worker.mjs",
    "d1:create": "wrangler d1 create auto-reels-db",
    "d1:migrate:local": "wrangler d1 migrations apply auto-reels-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply auto-reels-db --remote",
    "d1:seed:local": "node scripts/migrate_manager_db_to_d1.mjs",
    "r2:create": "wrangler r2 bucket create auto-reels-media",
    "queue:create": "wrangler queues create reels-publish-queue",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.14.0"
  }
}
